rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para la colección de transacciones
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Reglas para la colección de turnos
    match /turnos/{turnoId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    // Reglas para la colección de vehículos
    match /vehicles/{vehicleId} {
      allow read, write: if true;
    }

    // Reglas para la colección de historial
    match /historial/{historialId} {
      allow read, write: if true;
    }

    // Regla para la colección timeline (sin número)
    match /timeline/{timelineId} {
      allow read, write: if true;
    }

    // Reglas para colecciones timeline numeradas (por compatibilidad)
    match /{collectionId}/{document=**} {
      function isTimelineCollection() {
        return collectionId.matches('timeline[0-9]+');
      }
      allow read, write: if isTimelineCollection();
    }

    // Reglas para configuración de servicios
    match /service_config/{document} {
      allow read, write: if true;
    }

    // Reglas para admin
    match /admin/{document} {
      allow read, write: if true;
    }

    // 🆕 Reglas para settings (modo vacaciones)
    match /settings/{document} {
      allow read, write: if true;
    }

    // Reglas para gastos
    match /gastos/{document=**} {
      allow read, write: if true;
    }

    // Reglas para fluidos
    match /fluids/{document=**} {
      allow read, write: if true;
    }

    // Bloquear acceso a cualquier otra colección por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
